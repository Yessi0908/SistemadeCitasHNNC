# Genere SECRET_KEY con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# Si cambia SECRET_KEY, las contraseñas de referencia cifradas ya no se podrán leer.
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
# True solo en la PC de desarrollo. En el servidor del hospital: False
DEBUG=True
ALLOWED_HOSTS=hospital.local,localhost,127.0.0.1
USE_SQLITE=False
DB_NAME=hospital_nicolasacruz
DB_USER=postgres
DB_PASSWORD=cambiar_password_postgres
DB_HOST=localhost
DB_PORT=5432
JWT_ACCESS_MINUTES=480
JWT_REFRESH_DAYS=1
MAX_INTENTOS_LOGIN=5
BLOQUEO_MINUTOS=15
# Intentos de login permitidos por dirección IP
LIMITE_LOGIN_IP=10/min

# HTTPS (con DEBUG=False se activan solos). NUM_PROXIES=1 cuando NGINX está delante de Django.
NUM_PROXIES=0
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# Contraseñas de usuarios iniciales (python manage.py inicializar)
# Defina valores propios; no use estas cadenas de ejemplo en producción.
INIT_PASS_ARCHIVO=cambiar_archivo
INIT_PASS_REGISTROS=cambiar_registros
INIT_PASS_ESTADISTICA=cambiar_estadistica
INIT_PASS_JURIDICO=cambiar_juridico
INIT_PASS_ADMIN=cambiar_admin
